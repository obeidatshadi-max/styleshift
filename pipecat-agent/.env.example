# Set in Pipecat Cloud Secrets; never commit actual keys.
GOOGLE_API_KEY=
LIVE_PROVIDER=gemini
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Charon
# Only required for local Daily transport; Cloud provides the room credentials.
DAILY_API_KEY=

OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
# Empty uses the API default voice.
OPENAI_LIVE_VOICE=
# Optional Responses backend; empty declines delegated requests.
OPENAI_LIVE_BACKEND_MODEL=
